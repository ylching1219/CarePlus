      "item": [
        {
          "name": "Staff Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Parse the response body\nlet jsonData = pm.response.json();\n\n// Check if login was successful\nif (pm.response.code === 200 && jsonData.data && jsonData.data.token) {\n    // Save the access token into a collection variable\n    pm.collectionVariables.set(\"token\", jsonData.data.token);\n\n    // Keep this for future refresh-token support\n    if (jsonData.data.refreshToken) {\n        pm.collectionVariables.set(\"refreshToken\", jsonData.data.refreshToken);\n    }\n\n    console.log(\"Tokens saved to collection variables\");\n} else {\n    console.warn(\"Login failed or token not found in response\");\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"identifier\": \"admin001\",\r\n  \"password\": \"admin123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BaseUrl}}/Staff/Login",
              "host": [
                "{{BaseUrl}}"
              ],
              "path": [
                "Staff",
                "Login"
              ]
            }
          },
          "response": []
        },
