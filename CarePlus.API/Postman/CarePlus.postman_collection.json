{
  "info": {
    "_postman_id": "8f6d1f53-6d4f-4d3b-a8ed-1cfaf6c5c101",
    "name": "CarePlusApi",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "careplus-api"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Parse the response body",
                  "let jsonData = pm.response.json();",
                  "",
                  "// Check if login was successful",
                  "if (pm.response.code === 200 && jsonData.data && jsonData.data.token) {",
                  "    // Save the access token into a collection variable",
                  "    pm.collectionVariables.set(\"token\", jsonData.data.token);",
                  "",
                  "    // Keep this for future refresh-token support",
                  "    if (jsonData.data.refreshToken) {",
                  "        pm.collectionVariables.set(\"refreshToken\", jsonData.data.refreshToken);",
                  "    }",
                  "",
                  "    console.log(\"Tokens saved to collection variables\");",
                  "} else {",
                  "    console.warn(\"Login failed or token not found in response\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"identifier\": \"patient@example.com\",\r\n  \"password\": \"Password123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BaseUrl}}/User/Login",
              "host": [
                "{{BaseUrl}}"
              ],
              "path": [
                "User",
                "Login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Register Patient",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"username\": \"patient123\",\r\n  \"name\": \"Patient One\",\r\n  \"email\": \"patient@example.com\",\r\n  \"password\": \"Password123\",\r\n  \"gender\": \"M\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BaseUrl}}/Patient/Register",
              "host": [
                "{{BaseUrl}}"
              ],
              "path": [
                "Patient",
                "Register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Register Staff",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"username\": \"staff123\",\r\n  \"name\": \"Staff One\",\r\n  \"email\": \"staff@example.com\",\r\n  \"password\": \"Password123\",\r\n  \"role\": \"Doctor\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BaseUrl}}/Staff/Register",
              "host": [
                "{{BaseUrl}}"
              ],
              "path": [
                "Staff",
                "Register"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    }
  ]
}
